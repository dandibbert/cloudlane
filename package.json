{
  "name": "cloudlane",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Tunnel + SaaS 优选控制台，部署在 Workers 上",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "demo": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": { "wrangler": "4.129.0" }
}